{
  "name": "reposleuth-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @reposleuth/api\" \"npm run dev -w @reposleuth/web\"",
    "build": "npm run build -w @reposleuth/api && npm run build -w @reposleuth/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "eval": "npm run eval -w @reposleuth/api --",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "benchmark": "npm run benchmark -w @reposleuth/api --",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.{js,ts,json}\"",
    "benchmark:grade": "npm run benchmark:grade -w @reposleuth/api --",
    "eval:compare": "tsx apps/api/evaluation/reliability/compare.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
